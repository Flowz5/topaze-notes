rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(kbData) {
      return isAuthenticated() && kbData.ownerId == request.auth.uid;
    }

    function isMember(kbData) {
      return isAuthenticated() && (request.auth.token.email in kbData.members);
    }

    function hasAccess(kbData) {
      return isOwner(kbData) || isMember(kbData);
    }
    
    function isReasonableString(text, maxLength) {
      return text is string && text.size() <= maxLength;
    }
    
    // parentId peut être null (dossier racine) ou une string valide
    function isValidParentId(parentId) {
      return parentId == null || isReasonableString(parentId, 100);
    }

    match /knowledgeBases/{kbId} {
      allow read: if hasAccess(resource.data);
      
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerId == request.auth.uid
                    && isReasonableString(request.resource.data.name, 100)
                    && request.resource.data.members is list;
                    
      allow update: if isOwner(resource.data)
                    && isReasonableString(request.resource.data.name, 100)
                    && request.resource.data.members is list;
                    
      allow delete: if isOwner(resource.data);
      
      match /folders/{folderId} {
        allow read: if hasAccess(get(/databases/$(database)/documents/knowledgeBases/$(kbId)).data);
        allow write: if hasAccess(get(/databases/$(database)/documents/knowledgeBases/$(kbId)).data)
                     && isReasonableString(request.resource.data.name, 100)
                     && isValidParentId(request.resource.data.parentId)
                     && isReasonableString(request.resource.data.authorEmail, 150);
      }
      
      match /notes/{noteId} {
        allow read: if hasAccess(get(/databases/$(database)/documents/knowledgeBases/$(kbId)).data);
        allow write: if hasAccess(get(/databases/$(database)/documents/knowledgeBases/$(kbId)).data)
                     && isReasonableString(request.resource.data.title, 200)
                     && isReasonableString(request.resource.data.content, 1048576)
                     && isValidParentId(request.resource.data.folderId)
                     && isReasonableString(request.resource.data.authorEmail, 150);
      }
    }
  }
}
